# ── PixelFlow server config ─────────────────────────────────────────────
# Copy this file to `.env` and fill in. Every value below is optional except
# JWT_SECRET, which you should always set for anything other than local use.

PORT=5173

# Signs the session cookie. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Cookie lifetime in days.
SESSION_DAYS=30

# ── Database ────────────────────────────────────────────────────────────
# Leave TURSO_DATABASE_URL blank to use a local SQLite file. Set it (and the
# token) to use a hosted Turso/libSQL database instead — this is what you want
# on Vercel, where the filesystem is thrown away on every cold start.
# The schema is applied automatically at boot; there is no migration step.
#
#   npm install -g @libsql/cli
#   turso db create pixelflow
#   turso db tokens create pixelflow --json
#
# The token is only needed if the database is not fully public.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local file to use when TURSO_DATABASE_URL is blank. Relative paths are
# resolved against the directory you start the server from. Defaults to
# ./data/pixelflow.db.
DB_PATH=

# ── Sign in with Google / Microsoft ──────────────────────────────────────
# Both are optional and independent. Leave a pair blank and its button is
# hidden on the sign-in screen, so nothing appears that cannot work.
#
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth
# client ID → Web application. Authorised redirect URI, exactly:
#     http://127.0.0.1:5173/api/auth/google/callback
#
# Microsoft: entra.microsoft.com → App registrations → New registration.
# Supported account types: "Accounts in any organizational directory and
# personal Microsoft accounts". Redirect URI (Web), exactly:
#     http://127.0.0.1:5173/api/auth/microsoft/callback
#
# The redirect URI is derived from PUBLIC_ORIGIN above. Change PUBLIC_ORIGIN
# for a deployed host and use the resulting https:// URL in the console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Spotify (Web Playback SDK) ──────────────────────────────────────────
# Register a free app at https://developer.spotify.com/dashboard and choose
# "Web Playback SDK" when asked which APIs you plan to use.
#
# Set the Redirect URI to EXACTLY:
#     http://127.0.0.1:5173/auth/callback
#
# Spotify rejects "localhost" — you must use the explicit IPv4 loopback.
# Plain HTTP is only permitted on loopback, which is what we use.
#
# Playback inside the app requires a Spotify **Premium** account.
# Leave these blank to fall back to the simple paste-a-link embed player.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Where the Spotify app is served from. Must match the browser origin the
# player is embedded in (http://127.0.0.1:5173 by default).
PUBLIC_ORIGIN=http://127.0.0.1:5173

# Set to "1" to serve over HTTPS via a tunnel you run yourself, e.g.
#   cloudflared tunnel --url http://127.0.0.1:5173
# and then set SPOTIFY_CLIENT_ID / SECRET for that public origin too.
USE_HTTPS=0
