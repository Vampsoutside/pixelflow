{
  "name": "pixelflow",
  "version": "2.0.0",
  "private": true,
  "description": "PixelFlow \u2014 pixel-art pomodoro, study tracker and focus app",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test tests/*.test.js",
    "check": "node --check server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
